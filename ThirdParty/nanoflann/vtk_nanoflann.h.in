#ifndef vtk_nanoflann_h
#define vtk_nanoflann_h

/* Use the nanoflann library configured for VTK.  */
#cmakedefine01 VTK_MODULE_USE_EXTERNAL_VTK_nanoflann

#if VTK_MODULE_USE_EXTERNAL_VTK_nanoflann
#  include <nanoflann.hpp>
#else
#  include <vtknanoflann/include/nanoflann.hpp>
#endif

#endif // #ifndef vtk_nanoflann_h
