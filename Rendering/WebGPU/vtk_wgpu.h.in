#ifndef vtk_wgpu_h
#define vtk_wgpu_h

// Standard WebGPU C API header (vendored from VTK::webgpuheaders).
// Public API uses only C API to maintain C++17 compatibility.
#include "webgpu/webgpu.h"

// Whether Dawn was found and linked as the WebGPU implementation.
// dawn::native API is intentionally NOT included here — it is private to VTK's
// implementation and must not leak into the public interface.
#cmakedefine01 VTK_USE_DAWN_WEBGPU

#ifdef __EMSCRIPTEN__
/*
 * We need an up-to-date version of Emscripten for the API support.
 */
#if __EMSCRIPTEN_major__ == 1 &&                                                                   \
  (__EMSCRIPTEN_minor__ < 40 || (__EMSCRIPTEN_minor__ == 40 && __EMSCRIPTEN_tiny__ < 1))
#error "Emscripten 1.40.1 or higher required"
#endif
#endif // __EMSCRIPTEN__

#endif // vtk_wgpu_h
